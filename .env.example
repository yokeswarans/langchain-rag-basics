# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored, so never commit real keys.

# OpenAI: used in 03-Embeddings.ipynb (OpenAIEmbeddings)
OPENAI_API_KEY=your-openai-api-key

# Hugging Face: optional for public models, used in 03-Embeddings.ipynb
HF_TOKEN=your-huggingface-token
